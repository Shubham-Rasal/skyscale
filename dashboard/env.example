# Public dashboard origin, for example https://dashboard.example.com
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Neon pooled PostgreSQL connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require

# Browser reads and websocket streams still use this public control-plane URL.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Server-side proxy for authenticated GPU job submission.
SKYSCALE_CONTROL_PLANE_URL=http://localhost:8080

# --- FaaS / Railway (required for /faas) ---
# Account or workspace token; never commit real values.
RAILWAY_API_TOKEN=

# Optional override (default: https://backboard.railway.com/graphql/v2)
# RAILWAY_GRAPHQL_URL=

# Option A — explicit defaults (local dev or override hosted IDs)
FAAS_RAILWAY_SERVICE_ID=
FAAS_RAILWAY_ENVIRONMENT_ID=
# FAAS_RAILWAY_PROJECT_ID=

# When deployed ON Railway, these are typically injected automatically:
# RAILWAY_SERVICE_ID, RAILWAY_ENVIRONMENT_ID, RAILWAY_PROJECT_ID
# You can rely on them instead of FAAS_* if the dashboard should target its own service.

# Option B — per-template bindings (JSON). Overrides defaults per template id.
# FAAS_RAILWAY_SERVICES_JSON={"python-fastapi-fn":{"serviceId":"...","environmentId":"..."}}
